{
  "name": "high-value-projects-backend",
  "version": "1.0.0",
  "description": "High-Value Project Deliverables Management API with State-Based Permissions, Dependency Graph, Optimistic Concurrency, and Multi-Tenant Masking",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:push": "bunx prisma db push",
    "prisma:seed": "bun run src/prisma/seed.ts",
    "lint": "bunx biome check src"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@nodewave/prisma-ezfilter": "^0.2.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "hono": "^4.7.4",
    "jsonwebtoken": "^9.0.2",
    "pg-gateway": "^0.3.0-beta.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.4.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@embedded-postgres/windows-x64",
    "@prisma/client",
    "@prisma/engines",
    "prisma"
  ]
}
